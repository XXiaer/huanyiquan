<?xml version="1.0" encoding="UTF-8"?>
<!--
  打成 war 丢进 Tomcat 10.1+ 时用这份描述文件。
  用 mvn exec:java 跑内嵌 Tomcat 时不会读它，映射在 Application.java 里注册。
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>换一圈</display-name>

    <!-- 先登录校验，再管理员校验，顺序不能反 -->
    <filter>
        <filter-name>loginFilter</filter-name>
        <filter-class>com.huanyiquan.filter.LoginFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>loginFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>adminFilter</filter-name>
        <filter-class>com.huanyiquan.filter.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>adminFilter</filter-name>
        <url-pattern>/api/admin/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>userServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>userServlet</servlet-name>
        <url-pattern>/api/user/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>itemServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.ItemServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>itemServlet</servlet-name>
        <url-pattern>/api/item/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>offerServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.OfferServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>offerServlet</servlet-name>
        <url-pattern>/api/offer/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>cycleServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.CycleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>cycleServlet</servlet-name>
        <url-pattern>/api/cycle/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>exchangeServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.ExchangeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>exchangeServlet</servlet-name>
        <url-pattern>/api/exchange/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>reviewServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.ReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>reviewServlet</servlet-name>
        <url-pattern>/api/review/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>reportServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>reportServlet</servlet-name>
        <url-pattern>/api/report</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>adminServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>adminServlet</servlet-name>
        <url-pattern>/api/admin/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>uploadServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.UploadServlet</servlet-class>
        <multipart-config>
            <max-file-size>2097152</max-file-size>
            <max-request-size>4194304</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>uploadServlet</servlet-name>
        <url-pattern>/api/upload</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>uploadServlet</servlet-name>
        <url-pattern>/api/file/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>metaServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.MetaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>metaServlet</servlet-name>
        <url-pattern>/api/meta/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>staticServlet</servlet-name>
        <servlet-class>com.huanyiquan.servlet.StaticServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>staticServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <listener>
        <listener-class>com.huanyiquan.listener.TaskListener</listener-class>
    </listener>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
<servlet><servlet-name>auctionServlet</servlet-name><servlet-class>com.huanyiquan.servlet.AuctionServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>auctionServlet</servlet-name><url-pattern>/api/auction/*</url-pattern></servlet-mapping>
<servlet><servlet-name>communityServlet</servlet-name><servlet-class>com.huanyiquan.servlet.CommunityServlet</servlet-class></servlet>
<servlet-mapping><servlet-name>communityServlet</servlet-name><url-pattern>/api/community/*</url-pattern></servlet-mapping>
<servlet><servlet-name>notificationServlet</servlet-name><servlet-class>com.huanyiquan.servlet.NotificationServlet</servlet-class></servlet>
<servlet-mapping><servlet-name>notificationServlet</servlet-name><url-pattern>/api/notification/*</url-pattern></servlet-mapping>
<servlet><servlet-name>conversationServlet</servlet-name><servlet-class>com.huanyiquan.servlet.ConversationServlet</servlet-class></servlet>
<servlet-mapping><servlet-name>conversationServlet</servlet-name><url-pattern>/api/conversation/*</url-pattern></servlet-mapping>
<servlet><servlet-name>wishServlet</servlet-name><servlet-class>com.huanyiquan.servlet.WishServlet</servlet-class></servlet>
<servlet-mapping><servlet-name>wishServlet</servlet-name><url-pattern>/api/wish/*</url-pattern></servlet-mapping>
  <servlet><servlet-name>tradeThumbnailsServlet</servlet-name><servlet-class>com.huanyiquan.servlet.TradeThumbnailsServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>tradeThumbnailsServlet</servlet-name><url-pattern>/api/item/trade-thumbnails</url-pattern></servlet-mapping>
  <servlet><servlet-name>followersServlet</servlet-name><servlet-class>com.huanyiquan.servlet.FollowersServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>followersServlet</servlet-name><url-pattern>/api/social/followers</url-pattern><url-pattern>/api/social/follow</url-pattern></servlet-mapping>
  <servlet><servlet-name>socialServlet</servlet-name><servlet-class>com.huanyiquan.servlet.SocialServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>socialServlet</servlet-name><url-pattern>/api/social/*</url-pattern></servlet-mapping>
  <servlet><servlet-name>authEntryServlet</servlet-name><servlet-class>com.huanyiquan.servlet.AuthEntryServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>authEntryServlet</servlet-name><url-pattern>/api/user/register</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>authEntryServlet</servlet-name><url-pattern>/api/user/register/email/send</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>authEntryServlet</servlet-name><url-pattern>/api/user/login/email/send</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>authEntryServlet</servlet-name><url-pattern>/api/user/login/email/code</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>authEntryServlet</servlet-name><url-pattern>/api/user/login/email/password</url-pattern></servlet-mapping>
</web-app>
